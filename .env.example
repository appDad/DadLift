# Copy this file to .env.local and fill in real values.
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration
# .env.local is gitignored and never committed.
VITE_FB_API_KEY=your-firebase-web-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your-sender-id
VITE_FB_APP_ID=your-app-id

# Cloud console -> Security -> reCAPTCHA (the App Check key)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key
