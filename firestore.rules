rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ADMIN EMAIL — keep in sync with ADMIN_EMAIL in src/firebase.js =====
    function adminEmail() { return "egabel@gmail.com"; }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && userEmail() == adminEmail();
    }
    // A user is allowed if they're the admin or their email is on the allowlist.
    function isAllowed() {
      return signedIn()
        && (isAdmin() || exists(/databases/$(database)/documents/allowlist/$(userEmail())));
    }

    // Each user's private data (workout history, settings, custom exercises, login log)
    match /users/{uid}/{doc=**} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }

    // Shared exercise pool. Anyone on the roster can read and contribute;
    // only the original contributor or the admin can overwrite or delete.
    match /community/{exId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.resource.data.by == userEmail();
      allow update, delete: if isAllowed()
        && (isAdmin() || resource.data.by == userEmail());
    }

    // App-wide config (e.g. admin-added equipment catalog entries).
    match /config/{docId} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }

    // Public progress snapshots. Readable by anyone holding the unguessable
    // link token — that's the point of sharing. Only the owner manages theirs.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAllowed() && resource.data.uid == request.auth.uid;
    }

    // Roster of allowed emails. Users may check their own entry; only admin manages it.
    match /allowlist/{email} {
      allow get: if signedIn() && email == userEmail();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
